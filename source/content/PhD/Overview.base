properties:
  note.]:
    displayName: Author
views:
  - type: table
    name: Table
    order:
      - file.name
      - Unread
      - file.ext
      - Subject
    sort:
      - property: Subject
        direction: DESC
      - property: file.ext
        direction: DESC
      - property: Unread
        direction: ASC
      - property: "]"
        direction: DESC
      - property: new thing
        direction: ASC
